# scripts/probe.mjs 설정. 이 파일을 `.env.local` 로 복사해 채운다(그 이름은 git 이 무시한다).
#
# 앱을 띄우지 않고 rdp-core 를 직접 붙여 보는 개발용이다. 실제 자격증명이 들어가니 커밋 대상이
# 아닌지 반드시 확인할 것 — `git check-ignore services/rdp-core/.env.local` 로 확인된다.

RDP_HOST=
RDP_USER=Administrator
RDP_PASSWORD=

# 여기부터는 없어도 된다.
RDP_PORT=3389
RDP_DOMAIN=

# 선언할 모니터. `폭x높이@좌,상` 을 `;` 로 잇고, 주 모니터에 `*` 를 붙인다.
#   단일 화면:      1512x982@0,0*
#   맥북+외장 실측: 2560x1440@-2560,-458;1512x949@0,33*
RDP_MONITORS=1512x982@0,0*

# 붙어 있는 시간(초)과 rdp-core 로그 레벨.
RDP_SECONDS=12
RDP_LOG=info
