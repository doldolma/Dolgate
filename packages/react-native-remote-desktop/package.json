{
  "name": "@dolssh/react-native-remote-desktop",
  "version": "0.0.1",
  "description": "Native remote desktop surface (VNC/RDP) for React Native — Metal (iOS) and TextureView+OpenGL ES (Android)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "private": true,
  "react-native": "src/index.ts",
  "files": [
    "src",
    "ios",
    "android",
    "react-native-remote-desktop.podspec"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ffi:headers:check": "node ./scripts/check-ffi-headers.cjs",
    "test": "npm run ffi:headers:check && jest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "jest": "^29.6.3",
    "@types/jest": "^29.5.13",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "babel-jest": "^29.6.3"
  },
  "codegenConfig": {
    "name": "RemoteDesktopViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.dolssh.remotedesktop"
    }
  }
}
