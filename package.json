{
  "name": "dolssh",
  "version": "1.9.1",
  "engines": {
    "node": ">= 24.15.0",
    "npm": ">= 11.0.0"
  },
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  },
  "scripts": {
    "dev": "npm-run-all --parallel --print-label --race dev:desktop dev:api",
    "dev:desktop": "npm run dev --workspace @dolssh/desktop",
    "dev:mobile:android": "npm run dev:android --workspace @dolssh/mobile --",
    "dev:mobile:ios": "npm run dev:ios --workspace @dolssh/mobile --",
    "mobile:engine:build": "npm run build:engine --workspace @dolssh/mobile --",
    "build:mobile:android": "npm run build:android --workspace @dolssh/mobile --",
    "build:mobile:ios": "npm run build:ios --workspace @dolssh/mobile --",
    "version:set": "node ./scripts/version.cjs set",
    "version:check": "node ./scripts/version.cjs check",
    "version:bump:patch": "node ./scripts/version.cjs bump patch",
    "version:bump:minor": "node ./scripts/version.cjs bump minor",
    "version:bump:major": "node ./scripts/version.cjs bump major",
    "dev:api": "cd services/sync-api && cross-env WEBAUTHN_ENABLED=true WEBAUTHN_RP_ID=localhost WEBAUTHN_ORIGINS=http://localhost:8080 go run ./cmd/api",
    "generate:icons": "node ./apps/desktop/scripts/generate-icons.cjs",
    "build": "npm run build --workspace @dolssh/desktop",
    "release:dist:mac": "npm run release:dist:mac --workspace @dolssh/desktop",
    "release:dist:win": "npm run release:dist:win --workspace @dolssh/desktop",
    "release:dist:linux": "npm run release:dist:linux --workspace @dolssh/desktop",
    "release:mac": "npm run release:publish:mac --workspace @dolssh/desktop",
    "release:win": "npm run release:publish:win --workspace @dolssh/desktop",
    "release:linux": "npm run release:publish:linux --workspace @dolssh/desktop",
    "release:all": "npm run release:all --workspace @dolssh/desktop",
    "check": "npm run version:check && npm run typecheck && npm run test:fast && npm run test:mobile -- --runInBand",
    "check:js": "npm run version:check && npm run typecheck && npm run test:desktop && npm run test:mobile -- --runInBand",
    "test": "npm run test:fast",
    "test:fast": "npm run test:desktop && npm run test:services",
    "test:desktop": "npm run test --workspace @dolssh/desktop",
    "test:desktop:main": "npm run test:desktop:main --workspace @dolssh/desktop",
    "test:desktop:renderer": "npm run test:desktop:renderer --workspace @dolssh/desktop",
    "test:desktop:e2e-helpers": "npm run test:desktop:e2e-helpers --workspace @dolssh/desktop",
    "test:desktop:smoke": "npm run test:desktop:smoke --workspace @dolssh/desktop",
    "test:mobile": "node ./apps/mobile/scripts/prepare-runtime.cjs && cd apps/mobile && jest",
    "test:ssh-core": "cd services/ssh-core && go test ./... -cover",
    "test:sync-api": "cd services/sync-api && go test ./... -cover",
    "test:core-framing": "cd services/core-framing && cargo test --locked",
    "test:rdp-core": "cd services/rdp-core && cargo test --locked && cargo test --locked -p ironrdp-rdpdr-native",
    "test:vnc-core": "cd services/vnc-core && cargo test --locked",
    "test:rust": "npm run test:core-framing && npm run test:rdp-core && npm run test:vnc-core",
    "test:ssh-core:race": "go -C services/ssh-core test -race ./internal/sshsession ./internal/autocomplete -count=2",
    "test:sync-api:race": "cd services/sync-api && go test -race ./internal/store ./internal/http -run \"Vault|Sync\" -count=3",
    "lint:go": "go -C services/ssh-core vet ./mobile/ && go -C services/sync-api vet ./...",
    "test:services": "npm run test:ssh-core && npm run test:sync-api && npm run test:rust",
    "test:vault": "npm run test:desktop:main -- vault auth-service && npm run test:mobile -- --runInBand vault && cd services/sync-api && go test ./internal/store ./internal/auth ./internal/http -run \"Vault|Sync\"",
    "test:smoke": "npm run test:desktop:smoke",
    "test:all": "npm run check && npm run lint:go && npm run test:desktop:e2e-helpers && npm run test:ssh-core:race && npm run test:sync-api:race && npm run test:smoke",
    "typecheck": "npm-run-all --parallel typecheck:desktop typecheck:mobile",
    "typecheck:desktop": "npm run typecheck --workspace @dolssh/desktop",
    "typecheck:mobile": "node ./apps/mobile/scripts/prepare-runtime.cjs && cd apps/mobile && tsc --noEmit"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "npm-run-all": "^4.1.5"
  }
}
