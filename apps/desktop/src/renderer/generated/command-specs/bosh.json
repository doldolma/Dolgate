    {
      "name": "take-snapshot",
      "description": "Take snapshot",
      "args": [
        {
          "name": "INSTANCE-GROUP/INSTANCE-ID",
          "optional": true
        }
      ]
    },
    {
      "name": "sync-blobs",
      "description": "Sync blobs"
    },
    {
      "name": "stop-env",
      "description": "Stop BOSH environment"
    },
    {
      "name": "stop",
