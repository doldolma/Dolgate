{
  "name": "degit",
  "description": "Straightforward project scaffolding",
  "options": [
    {
      "names": [
        "--help"
      ],
      "description": "Print help"
    },
    {
      "names": [
        "-f",
        "--force"
      ],
      "description": "Overwrite existing files"
    },
    {
      "names": [
        "-c",
        "--cache"
      ],
      "description": "Use a cache"
    },
    {
      "names": [
        "-v",
        "--verbose"
      ],
      "description": "Be verbose?"
    },
    {
      "names": [
        "-m",
        "--mode"
      ],
      "description": "Clone mode",
      "takesArg": true,
      "args": [
        {
          "name": "mode"
        }
      ]
    }
  ],
  "args": [
    {
      "name": "user/repo",
      "hasGenerator": true
    },
    {
      "name": "location",
      "optional": true,
      "template": "folders"
    }
  ]
}
