        {
          "names": [
            "-e",
            "--profile"
          ],
          "description": "Name of the build profile from eas.json. Defaults to \"production\" if defined in eas.json",
          "takesArg": true,
          "args": [
            {
              "name": "Profile Name"
            }
          ]
        },
        {
          "names": [
            "-o",
            "--output"
          ],
          "description": "(required) Output directory",
          "takesArg": true,
          "args": [
            {
              "name": "Output directory"
            }
          ]
        },
        {
          "names": [
            "-p",
            "--platform"
          ],
          "description": "(required)",
          "takesArg": true,
          "args": [
            {
              "name": "Platform"
            }
          ]
        },
        {
          "names": [
            "-s",
            "--stage"
          ],
          "description": "(required) Stage of the build you want to inspect.\narchive - builds the project archive that would be uploaded to EAS when building\npre-build - prepares the project to be built with Gradle/Xcode. Does not run the native build.\npost-build - builds the native project and leaves the output directory for inspection",
          "takesArg": true,
          "args": [
            {
              "name": "Build Stage"
            }
          ]
        },
        {
          "names": [
            "-v",
            "--verbose"
          ]
        },
        {
          "names": [
            "--force"
          ],
          "description": "Delete OUTPUT_DIRECTORY if it already exists"
