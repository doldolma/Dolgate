              "description": "Define an environment declaration. To specify multiple declarations, use multiple options or use commas to separate key-value pairs. For example: dart compile aot-snapshot -D a=1,b=2 main.dart",
              "takesArg": true,
              "args": [
                {
                  "name": "key-value-pairs",
                  "variadic": true
                }
              ]
            },
            {
              "names": [
                "--enable-asserts"
              ],
              "description": "Enable assert statements"
            },
            {
              "names": [
                "-p",
                "--packages"
