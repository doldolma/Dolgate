{
  "name": "dscl",
  "description": "Directory Service command line utility",
  "options": [
    {
      "names": [
        "-p"
      ],
      "description": "Prompt for password"
    },
    {
      "names": [
        "-u"
      ],
      "description": "Authenticate as user",
      "takesArg": true,
      "args": [
        {
          "name": "user"
        }
      ]
    },
    {
      "names": [
        "-P"
      ],
      "description": "Authenticate with password",
      "takesArg": true,
      "args": [
        {
          "name": "password"
        }
      ]
    },
    {
      "names": [
        "-f"
      ],
      "description": "Targeted local node database file path",
      "takesArg": true,
      "args": [
        {
          "name": "file"
        }
      ]
    },
    {
      "names": [
        "-raw"
      ],
      "description": "Don't strip off prefix from DirectoryService API constants"
    },
    {
      "names": [
        "-plist"
      ],
      "description": "Print out record(s) or attribute(s) in XML plist format"
    },
    {
      "names": [
        "-url"
      ],
      "description": "Print record attribute values in URL-style encoding"
    },
    {
      "names": [
        "-q"
      ],
      "description": "Quiet - no interactive prompt"
    }
  ],
  "subcommands": [
    {
      "name": "read",
      "description": "Prints a directory",
      "args": [
        {
          "name": "path",
          "optional": true,
          "hasGenerator": true
        },
        {
          "name": "keys",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "readall",
      "description": "Prints all the records of a given type",
      "args": [
        {
          "name": "path",
          "optional": true,
          "hasGenerator": true
        },
        {
          "name": "keys",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "readpl",
      "description": "Prints the contents of plist_path",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "plist path"
        }
      ]
    },
    {
      "name": "readpli",
      "description": "Prints the contents of plist_path for the plist at value_index of the key",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "value index"
        },
        {
          "name": "plist path"
        }
      ]
    },
    {
      "name": "list",
      "description": "Lists the subdirectories of the given directory",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key",
          "optional": true
        }
      ]
    },
    {
      "name": "search",
      "description": "Searches for records that match a pattern",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "val"
        }
      ]
    },
    {
      "name": "create",
      "description": "Creates a new record",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key",
          "optional": true
        },
        {
          "name": "vals",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "createpl",
      "description": "Creates a string, or array of strings at plist_path",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "plist path"
        },
        {
          "name": "val"
        },
        {
          "name": "vals",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "createpli",
      "description": "Creates a string, or array of strings at plist_path for the plist at value_index of the key",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "value index"
        },
        {
          "name": "plist path"
        },
        {
          "name": "val"
        },
        {
          "name": "vals",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "append",
      "description": "Appends one or more values to a property in a given record",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "vals",
          "variadic": true
        }
      ]
    },
    {
      "name": "merge",
      "description": "Appends one or more values to a property in a given directory if the property does not already have those values",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "vals",
          "variadic": true
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete a directory, property, or value",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key",
          "optional": true
        },
        {
          "name": "vals",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "deletepl",
      "description": "Deletes a value in a plist",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "plist path"
        },
        {
          "name": "vals",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "deletepli",
      "description": "Deletes a value for the plist at value_index of the key",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "value index"
        },
        {
          "name": "plist path"
        },
        {
          "name": "vals",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "change",
      "description": "Replaces the given old value in the list of values of the given key with the new value in the specified record",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "old val"
        },
        {
          "name": "new val"
        }
      ]
    },
    {
      "name": "changei",
      "description": "Replaces the value at the given index in the list of values of the given key with the new value in the specified record",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "key"
        },
        {
          "name": "value index"
        },
        {
          "name": "new val"
        }
      ]
    },
    {
      "name": "diff",
      "description": "Compares the data from path1 and path2 looking at the specified keys (or all if no keys are specified)",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "keys",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "passwd",
      "description": "Changes the password of a user",
      "args": [
        {
          "name": "path",
          "hasGenerator": true
        },
        {
          "name": "new password",
          "optional": true
        }
      ]
    }
  ],
  "args": [
    {
      "name": "datasource",
      "optional": true
    }
  ]
}
