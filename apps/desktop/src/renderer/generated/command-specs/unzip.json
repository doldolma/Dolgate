{
  "name": "unzip",
  "description": "Extract compressed files in a ZIP archive",
  "options": [
    {
      "names": [
        "-l"
      ],
      "description": "List the contents of a zip file without extracting",
      "takesArg": true,
      "args": [
        {
          "name": "file",
          "template": "filepaths"
        }
      ]
    },
    {
      "names": [
        "-c"
      ],
      "takesArg": true,
      "args": [
        {
          "name": "file",
          "template": "filepaths"
        }
      ]
    },
    {
      "names": [
        "-0"
      ],
      "description": "Extract a zip file created in windows, containing files with non-ascii (chinese) filenames",
      "takesArg": true,
      "args": [
        {
          "name": "gbk"
        },
        {
          "name": "file",
          "template": "filepaths"
        }
      ]
    },
    {
      "names": [
        "-d"
      ],
      "takesArg": true,
      "args": [
        {
          "name": "destination",
          "template": "folders"
        }
      ]
    }
  ],
  "args": [
    {
      "name": "file",
      "template": "filepaths"
    }
  ]
}
