        "--cleanexit"
      ],
      "description": "Exit with a success exit code (0) unless an error is thrown"
    },
    {
      "names": [
        "--quiet"
      ],
      "description": "Don't return anything to stdout"
    },
    {
      "names": [
        "--nointeraction"
      ],
      "description": "Do not prompt for interactive user input"
