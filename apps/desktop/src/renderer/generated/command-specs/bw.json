{
  "name": "bw",
  "options": [
    {
      "names": [
        "--pretty"
      ],
      "description": "Format output. JSON is tabbed with two spaces"
    },
    {
      "names": [
        "--raw"
      ],
      "description": "Return raw output instead of a descriptive message"
    },
    {
