{
  "name": "@dolssh/desktop",
  "version": "1.7.8",
  "private": true,
  "description": "Dolgate desktop client",
  "author": "doldolma",
  "repository": {
    "type": "git",
    "url": "https://github.com/doldolma/dolgate.git"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "generate:icons": "node ./scripts/generate-icons.cjs",
    "generate:specs": "node ./scripts/generate-command-specs.cjs",
    "sync:runtime-deps": "node ./scripts/sync-runtime-deps.cjs",
    "sync:runtime-deps:mac": "cross-env DOLSSH_TARGET_PLATFORM=darwin node ./scripts/sync-runtime-deps.cjs",
    "sync:runtime-deps:win": "cross-env DOLSSH_TARGET_PLATFORM=win32 node ./scripts/sync-runtime-deps.cjs",
    "prepare:ssh-core:dev": "node ./scripts/build-ssh-core-dev.cjs",
    "postinstall": "npm run sync:runtime-deps",
    "predev": "npm run prepare:ssh-core:dev",
    "prebuild": "npm run generate:icons && npm run sync:runtime-deps",
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "release:clean": "node -e \"const fs=require('node:fs'); fs.rmSync('release/dist',{recursive:true,force:true});\"",
    "release:auth": "node ./scripts/github-device-login.cjs",
    "release:prepare:ssh:mac": "node ./scripts/build-ssh-core.cjs darwin universal",
    "release:prepare:ssh:win": "node ./scripts/build-ssh-core.cjs win32 x64",
    "release:package:mac": "npm run sync:runtime-deps:mac && cross-env DOLSSH_TARGET_PLATFORM=darwin DOLSSH_TARGET_ARCH=universal electron-forge package --platform darwin --arch universal",
    "release:package:win": "npm run sync:runtime-deps:win && cross-env DOLSSH_TARGET_PLATFORM=win32 DOLSSH_TARGET_ARCH=x64 electron-forge package --platform win32 --arch x64",
    "release:dist:mac": "npm run release:clean && npm run generate:icons && npm run release:prepare:ssh:mac && npm run release:package:mac && electron-builder --config electron-builder.config.cjs --mac dmg zip --universal --publish never --prepackaged out/dolgate-darwin-universal/dolgate.app",
    "release:dist:win": "npm run release:clean && npm run generate:icons && npm run release:prepare:ssh:win && npm run release:package:win && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never --prepackaged out/dolgate-win32-x64",
    "release:publish:mac": "node ./scripts/release-publish.cjs mac",
    "release:publish:win": "node ./scripts/release-publish.cjs win",
    "release:all": "node ./scripts/release-publish.cjs all",
    "test": "npm run test:desktop:main && npm run test:desktop:preload && npm run test:desktop:renderer",
    "test:desktop:main": "vitest run --config vite.main.config.ts",
    "test:desktop:preload": "vitest run --config vite.preload.config.ts",
    "test:desktop:renderer": "vitest run --config vite.renderer.config.ts",
    "test:desktop:e2e-helpers": "node --test e2e/*.unit.cjs",
    "ensure:smoke-package": "node ./scripts/ensure-smoke-package.cjs",
    "ensure:smoke-package:fresh": "node ./scripts/ensure-smoke-package.cjs --fresh",
    "test:desktop:smoke": "npm run prepare:ssh-core:dev && npm run ensure:smoke-package && cross-env DOLSSH_E2E_USE_PACKAGED_APP=1 playwright test -c playwright.config.ts",
    "test:desktop:smoke:fresh": "npm run prepare:ssh-core:dev && npm run ensure:smoke-package:fresh && cross-env DOLSSH_E2E_USE_PACKAGED_APP=1 playwright test -c playwright.config.ts",
    "test:desktop:smoke:packaged": "npm run prepare:ssh-core:dev && npm run ensure:smoke-package && cross-env DOLSSH_E2E_USE_PACKAGED_APP=1 playwright test -c playwright.config.ts e2e/replay.spec.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1028.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1028.0",
    "@aws-sdk/client-ec2": "^3.1028.0",
    "@aws-sdk/client-ec2-instance-connect": "^3.1028.0",
    "@aws-sdk/client-ecs": "^3.1028.0",
    "@aws-sdk/client-ssm": "^3.1028.0",
    "@aws-sdk/client-sso": "^3.1028.0",
    "@aws-sdk/client-sso-oidc": "^3.1032.0",
    "@aws-sdk/client-sts": "^3.1028.0",
    "@aws-sdk/credential-provider-ini": "^3.972.29",
    "@codemirror/language-data": "^6.5.2",
    "@dolssh/shared-core": "*",
    "@fontsource/cascadia-code": "^5.2.3",
    "@fontsource/cascadia-mono": "^5.2.3",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inconsolata": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/roboto-mono": "^5.2.9",
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/space-mono": "^5.2.9",
    "@fontsource/ubuntu-mono": "^5.2.8",
    "@fontsource/victor-mono": "^5.2.8",
    "@uiw/codemirror-theme-vscode": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@vscode/sudo-prompt": "^9.3.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "fuse.js": "^7.0.0",
    "lucide-react": "^1.21.0",
    "nora-zmodemjs": "^1.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.3.1",
    "uplot": "^1.6.32",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0",
    "xterm-addon-image": "^0.5.0",
    "xterm-addon-search": "0.13.0",
    "xterm-addon-serialize": "^0.11.0",
    "xterm-addon-unicode11": "0.6.0",
    "xterm-addon-webgl": "0.16.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@electron/notarize": "^3.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
